; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
#include "CodeDependencies.iss"

#define MyAppName "AI-O Key"
#ifndef MyAppVersion
  #define MyAppVersion "0.0.0-dev"
#endif
; 入れるファイルのフォルダ。Release のワークフローは配布物の zip と同じフォルダを渡す（ISCC /DSourceDir=...）。
; 開発用は scripts/build-windows.sh が集める ../build
#ifndef SourceDir
  #define SourceDir "../build"
#endif
#define MyAppPublisher "marby3"
#define MyAppURL "https://github.com/marby3/AI-Okey/"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{DF1F8404-A5DA-4E67-A9CE-F26B137C841A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; rc.3 までは %APPDATA%\aiokey に入れていたが、ユーザーが書き込める場所の未署名の DLL を Defender が
; トロイの木馬として検疫した。IME と同じく Program Files に入れる（前回のフォルダは引き継がない）
DefaultDirName={autopf}\AI-O Key
UsePreviousAppDir=no
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputDir=../build
OutputBaseFilename=aiokey-setup-v{#MyAppVersion}
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin

[Languages]
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"

[Files]
; TSF（x64 と x86）。インストールのときに登録し、アンインストールのときに登録を解除する
Source: "{#SourceDir}/aiokey.dll"; DestDir: "{app}"; DestName: "aiokey.dll"; Flags: ignoreversion regserver 64bit restartreplace uninsrestartdelete
Source: "{#SourceDir}/x86/aiokey.dll"; DestDir: "{app}"; DestName: "aiokey32.dll"; Flags: ignoreversion regserver 32bit restartreplace uninsrestartdelete
; 変換サーバー、候補ウィンドウ、ランチャー、CLI、辞書、学習済みの段2とその校正値、ライセンス
Source: "{#SourceDir}/aiokey-server.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/aiokey-ui.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/aiokey-launcher.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/aiokey-cli.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/aiokey.dic"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/aiokey-ngram.bin"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/aiokey-stage2-q8_0.gguf"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/aiokey-stage2.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}/LICENSE"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#SourceDir}/NOTICE"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#SourceDir}/MOZC-DICTIONARY-README.txt"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
; ログオン時にランチャーを起動する（すべてのユーザーの Run キー。起動に管理者の権限は要らない）。
; 管理者でインストールすると HKCU は昇格したアカウントのものになるので、HKLM に置く
Root: HKLM; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "AI-O Key"; ValueData: """{app}\aiokey-launcher.exe"""; Flags: uninsdeletevalue
; rc.3 まではユーザーの Run キーに登録していた
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: none; ValueName: "AI-O Key"; Flags: deletevalue

[Run]
; rc.2 まではタスク スケジューラで起動していた（実機で登録されなかった）。残っていれば消す
Filename: "schtasks"; Parameters: "/Delete /TN ""AI-O Key Startup"" /F"; Flags: runhidden
; インストールの直後に、管理者ではないユーザーとして起動する（サインインし直さなくても使える）
Filename: "{app}\aiokey-launcher.exe"; Flags: nowait runasoriginaluser
Filename: "icacls"; \
  Parameters: """{app}\aiokey.dll"" /grant ""*S-1-15-2-1:(RX)"""; \
  Description: "Grant Permission"; \
  Flags: runhidden postinstall runascurrentuser
Filename: "icacls"; \
  Parameters: """{app}\aiokey32.dll"" /grant ""*S-1-15-2-1:(RX)"""; \
  Description: "Grant Permission"; \
  Flags: runhidden postinstall runascurrentuser

[UninstallRun]
; 動いているランチャー、サーバー、候補ウィンドウを止めてから消す
Filename: "powershell.exe"; Parameters: "-NoProfile -Command ""{code:StopCommand}"""; \
  Flags: runhidden runascurrentuser; RunOnceId: "StopAiokey"
Filename: "schtasks"; \
  Parameters: "/Delete /TN ""AI-O Key Startup"" /F"; \
  Flags: runhidden runascurrentuser

[Code]
function InitializeSetup: Boolean;
begin
  Dependency_AddVC2015To2022x64;
  Dependency_AddVC2015To2022x86;

  Result := True;
end;

// 入れ直し・更新のときに、動いているファイルを置き換えられるよう、先に止める（アプリに読み込まれている
// aiokey.dll は止められないので、restartreplace で再起動のときに置き換える）
// 入れる先のフォルダから動いているランチャー、サーバー、候補ウィンドウだけを止める（ほかの場所の同名のものは止めない）
// Param を省くと、入れる先のフォルダ
function StopCommand(Param: String): String;
var
  Dir: String;
begin
  Dir := Param;
  if Dir = '' then
    Dir := ExpandConstant('{app}');
  // PowerShell の '…' の中では ' を 2 つ重ねる
  StringChangeEx(Dir, '''', '''''', True);
  Result := 'Get-Process aiokey-launcher, aiokey-server, aiokey-ui -ErrorAction SilentlyContinue | ' +
    'Where-Object { $_.Path -like ''' + Dir + '\*'' } | Stop-Process -Force';
end;

// rc.3 まで（%APPDATA%\aiokey）に入れたファイル。設定（settings.json）は残す
function OldInstallDir(): String;
begin
  Result := ExpandConstant('{userappdata}\aiokey');
end;

// アプリに読み込まれている DLL は消せないので、再起動のときに消す
procedure DeleteOldFile(Name: String);
var
  Path: String;
begin
  Path := OldInstallDir() + '\' + Name;
  if FileExists(Path) and not DeleteFile(Path) then
    RestartReplace(Path, '');
end;

// DLL の登録（CLSID と TSF のプロファイル）は、同じ CLSID で新しい DLL を登録するときに上書きされる
procedure RemoveOldInstall();
var
  Dummy: Integer;
begin
  if not FileExists(OldInstallDir() + '\aiokey-launcher.exe') then
    Exit;
  Exec('powershell.exe', '-NoProfile -Command "' + StopCommand(OldInstallDir()) + '"', '', SW_HIDE, ewWaitUntilTerminated, Dummy);
  DeleteOldFile('aiokey.dll');
  DeleteOldFile('aiokey32.dll');
  DeleteOldFile('aiokey-launcher.exe');
  DeleteOldFile('aiokey-server.exe');
  DeleteOldFile('aiokey-ui.exe');
  DeleteOldFile('aiokey-cli.exe');
  DeleteOldFile('aiokey.dic');
  DeleteOldFile('aiokey-ngram.bin');
  DeleteOldFile('aiokey-stage2-q8_0.gguf');
  DeleteOldFile('aiokey-stage2.json');
  DeleteOldFile('LICENSE');
  DeleteOldFile('NOTICE');
  DeleteOldFile('MOZC-DICTIONARY-README.txt');
  DeleteOldFile('launch.vbs');
  DeleteOldFile('unins000.exe');
  DeleteOldFile('unins000.dat');
  RemoveDir(OldInstallDir());
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Dummy: Integer;
begin
  Exec('powershell.exe', '-NoProfile -Command "' + StopCommand('') + '"', '', SW_HIDE, ewWaitUntilTerminated, Dummy);
  RemoveOldInstall();
  Result := '';
end;

function UninstallNeedRestart(): Boolean;
begin
  Result := True;
end;

function CmdLineContains(Param: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to ParamCount do
  begin
    if CompareText(ParamStr(I), Param) = 0 then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpFinished then
    WizardForm.RunList.Visible := False;
end;

